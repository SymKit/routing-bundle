{
    "name": "symkit/routing-bundle",
    "description": "Dynamic database-driven routing bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Symkit\\RoutingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symkit\\RoutingBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^3.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symkit/crud-bundle": "^0.0.2",
        "symkit/form-bundle": "^0.0.1",
        "symkit/metadata-bundle": "^0.0.1",
        "symkit/menu-bundle": "^0.0.1",
        "symkit/search-bundle": "^0.0.1",
        "symkit/sitemap-bundle": "^0.0.1"
    },
    "require-dev": {
        "deptrac/deptrac": "^2.0",
        "infection/infection": "^0.29",
        "phpro/grumphp": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symkit/bundle-ai-kit": "^0.0.7",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "suggest": {
        "symkit/sitemap-bundle": "For sitemap integration (expose routes in sitemap)",
        "symkit/search-bundle": "For global search integration (searchable routes)"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpro/grumphp": true,
            "symkit/bundle-ai-kit": true
        }
    },
    "extra": {
        "bundle-ai-kit": {
            "editors": ["cursor"],
            "skills": ["symfony-bundle-core", "symfony-bundle-ux", "symfony-bundle-doctrine", "symfony-bundle-flex", "symfony-bundle-quality"]
        }
    }
}
